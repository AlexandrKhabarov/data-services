# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=dataservices

# ── API security ─────────────────────────────────────────────────────────────
# Used to sign internal tokens. Change before deploying.
SECRET_KEY=changethis_at_least_32_chars_long_secret

# Master admin key — grants full access (account management + analysis API).
ADMIN_API_KEY=changethis_admin_key

# Comma-separated list of read-only API keys for external callers (optional).
# Leave empty to use ADMIN_API_KEY for everything.
# API_KEYS=key1,key2

# ── Telegram session encryption ──────────────────────────────────────────────
# Must be a valid Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_TARGET_BOT=mycommentinst_bot
TELEGRAM_REPLY_TIMEOUT_SECONDS=60

# ── App environment ──────────────────────────────────────────────────────────
# Options: local | staging | production
ENVIRONMENT=local

# ── CORS (frontend origin) ───────────────────────────────────────────────────
FRONTEND_HOST=http://localhost:5173

# ── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=
